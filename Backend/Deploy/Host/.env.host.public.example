# ==============================================================================
# JungleMaze Standalone Selfhost Environment (Public Mode)
# ==============================================================================
# IMPORTANT:
# 1. Copy this file to .env.host.public:
#    cp .env.host.public.example .env.host.public
# 2. Fill in all required values (generate random tokens, set your domain).
# 3. DO NOT commit .env.host.public to version control.
# 4. Run:
#    docker compose -f compose.host.yaml --env-file Deploy/Host/.env.host.public up -d
# ==============================================================================

# Compose Profile: activates mongo, api, game-server, and caddy (public TLS)
COMPOSE_PROFILES=public

# Database Configuration (isolated database name in dedicated volume mongo-host-data)
HOST_MONGO_DATABASE=jungle_maze_host
# MONGO_IMAGE=mongo:7.0.43

# Public Hosting Flags
PUBLIC_HOSTING=true
ALLOW_LOCAL_HTTP=false

# Public Domain & ACME TLS Configuration
# NOTE: Must differ from AWS domain (junglemaze.duckdns.org)!
HOST_DOMAIN=junglemaze-selfhost.duckdns.org
ACME_EMAIL=admin@example.com

# Ports Configuration (Caddy 80/443 TCP, GameServer 7777 UDP)
# Direct API (5000), Mongo (27017), RoomControl (7780), and WS (7781) are NOT published to host.
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443
HOST_GAME_UDP_PORT=7777
HOST_GAME_UDP_BIND=0.0.0.0

# Swagger Basic Authentication
# Generate hash with: docker run --rm caddy:2.8-alpine caddy hash-password --plaintext "YourPassword"
# Keep the bcrypt hash in single quotes in this env file; never put a password here.
SWAGGER_USER=hostadmin
SWAGGER_HASH='$2a$14$REPLACE_WITH_HASH_FROM_CADDY_HASH_PASSWORD'

# Match & Room Configuration
MATCH_PROFILE=main
AUTH_MODE=RoomCode
ROOM_CODE=HOST01
MAX_PLAYERS=10
TICK_RATE=30
SWAGGER_ENABLED=true

# ==============================================================================
# ISOLATED SECRETS (Do NOT overwrite old secrets from local .env or AWS runners!)
# Generate each token independently:
#   Windows PowerShell: [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
#   Linux/macOS:        openssl rand -hex 32
# ==============================================================================

# 1. JWT Signing Key: Min 32 chars, used by Api for user/guest auth tokens
JWT_SIGNING_KEY=REPLACE_WITH_UNIQUE_32_CHAR_OR_LONGER_HEX_SECRET_FOR_HOST_JWT

# 2. Room Control Token: Shared secret strictly between Api and GameServer for room management
ROOM_CONTROL_TOKEN=REPLACE_WITH_UNIQUE_ROOM_CONTROL_TOKEN_DIFFERENT_FROM_JWT

# 3. Match Result Token: Shared secret strictly between GameServer and Api for posting match results
MATCH_RESULT_TOKEN=REPLACE_WITH_UNIQUE_MATCH_RESULT_TOKEN_DIFFERENT_FROM_CONTROL
