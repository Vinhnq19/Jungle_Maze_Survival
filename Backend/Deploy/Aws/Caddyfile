{
    email {$ACME_EMAIL}
    # Security Group chỉ mở TCP 443: không bật HTTP/3 UDP 443.
    servers {
        protocols h1 h2
    }
}

{$PUBLIC_DOMAIN} {
    # GameServer-only result/control endpoints must never be reachable through the public proxy.
    @internal path /internal /internal/*
    handle @internal {
        respond 404
    }
    handle /game {
        reverse_proxy game-server:7781
    }
    @swagger path /swagger /swagger/*
    basic_auth @swagger {
        {$SWAGGER_USER} {$SWAGGER_HASH}
    }
    reverse_proxy api:5000
}
