# Copy thành .env, đổi ROOM_CODE. Không commit .env.
PUBLISH_HOST=127.0.0.1
# Optional per-service host bind. Empty = fall back to PUBLISH_HOST above.
# LAN/VPN: set GAME_PUBLISH_HOST to the host LAN/VPN IPv4; keep API on loopback.
GAME_PUBLISH_HOST=
API_PUBLISH_HOST=127.0.0.1
GAME_BIND_ADDRESS=0.0.0.0
GAME_PORT=7777
WS_ENABLED=true
WS_PUBLISH_HOST=127.0.0.1
WS_PORT=7781
API_PORT=5000
MONGO_PORT=27018
MAX_PLAYERS=10
TICK_RATE=30
METRICS_INTERVAL_SECONDS=5
AUTH_MODE=RoomCode
AUTH_TIMEOUT_MS=5000
ROOM_CODE=CHANGE_ROOM_CODE
# Optional: random secret >=32 bytes shared by API/GameServer. Empty = default room only.
ROOM_CONTROL_TOKEN=
MAX_ROOM_PLAYERS=10
MAX_TOTAL_PLAYERS=50
MAX_ROOMS=5
MAX_ROOMS_PER_USER=2
ROOM_EMPTY_TTL_SECONDS=600
SWAGGER_ENABLED=true
# Chỉ cần JWT khi bật account/Jwt; API và GameServer dùng cùng secret random >=32 byte.
Jwt__Issuer=JungleMaze.Local
Jwt__Audience=JungleMaze.Game
Jwt__SigningKey=REPLACE_WITH_RANDOM_KEY
Jwt__ExpiryMinutes=60

# Phase 2: main = GDD min6; test = min2 + accelerated timings, Local only.
MATCH_PROFILE=main
# Dedicated random secret >=32 UTF-8 bytes shared only by API and GameServer.
# Empty disables result delivery; RoomCode gameplay remains available.
MATCH_RESULT_TOKEN=
